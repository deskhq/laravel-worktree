#!/usr/bin/env php
<?php

/**
 * Host entry point for deskhq/laravel-worktree.
 *
 * This binary is the real implementation, and it runs on the host: git
 * worktrees, host ports and the sibling worktrees directory are all unreachable
 * from inside the application container, so `php artisan worktree:*` is only a
 * facade standing in front of it (see src/Commands). Laravel is never booted —
 * nothing here depends on an application that may not be installed yet, or may
 * be broken.
 */

use DeskHQ\LaravelWorktree\Console\Application;

$autoloaders = [
    // Installed as a dependency: vendor/deskhq/laravel-worktree/bin/worktree.
    __DIR__.'/../../../autoload.php',
    // Developing the package itself.
    __DIR__.'/../vendor/autoload.php',
];

$loaded = false;

foreach ($autoloaders as $autoloader) {
    if (file_exists($autoloader)) {
        require $autoloader;
        $loaded = true;

        break;
    }
}

if (! $loaded) {
    fwrite(STDERR, "error: could not find the Composer autoloader; run 'composer install'\n");

    exit(1);
}

exit(Application::create()->run($argv));
